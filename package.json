{
  "name": "groupwisdom-mcp",
  "version": "1.2.0",
  "private": true,
  "description": "Claude MCP connector for GroupWisdom \u2014 the intelligence layer for groups",
  "type": "module",
  "bin": {
    "groupwisdom-mcp": "dist/mcp.js"
  },
  "files": [
    "dist/mcp.js"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx src/index.ts",
    "mcp": "node --env-file-if-exists=.env dist/mcp.js",
    "buzz": "tsx --env-file-if-exists=.env --env-file-if-exists=.buzz-agent.env src/buzz-run.ts",
    "seed": "node dist/seed.js",
    "giftswipe": "cd ../giftswipe && PORT=3001 node_modules/.bin/tsx --env-file=.env src/index.ts",
    "buzz:authorize": "tsx src/buzz-authorize.ts",
    "buzz:test": "tsx src/adapters/nip-oa.test.ts",
    "test:api": "GW_DB=/tmp/gw-test-api.db ANTHROPIC_API_KEY=x ANTHROPIC_BASE_URL=http://127.0.0.1:4713 GW_WISDOM_COOLDOWN_MIN=0 tsx test/api-stress.ts",
    "test:scout": "GW_DB=/tmp/gw-scout.db tsx test/scout-truncation-test.ts",
    "test:handoff": "GW_DB=/tmp/gw-handoff.db tsx test/handoff-test.ts",
    "test:ssrf": "node test/ssrf-test.mjs",
    "test:keys": "GW_DB=/tmp/gw-keys.db tsx test/key-storage-test.ts",
    "test:teams-memory": "tsx test/teams-memory-test.ts",
    "test:grounding": "tsx test/grounding-test.ts",
    "test:teams-activity": "tsx test/teams-activity-test.ts",
    "test:teams": "GW_DB=/tmp/gw-teams.db tsx test/teams-route-test.ts",
    "test:json": "node test/json-repair-test.mjs",
    "smoke": "node test/prod-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "bcrypt": "^6.0.0",
    "express": "^4.21.0",
    "express-session": "^1.19.0",
    "multer": "^2.1.1",
    "nostr-tools": "^2.24.1",
    "pdf-parse": "^2.4.5",
    "ws": "^8.21.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.0",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
