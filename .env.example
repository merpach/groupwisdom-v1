# Optional. Without a key the insight engine runs in mock mode.
ANTHROPIC_API_KEY=
# Claude model used by the insight engine
GW_MODEL=claude-sonnet-4-6
# Server port
PORT=3000
# SQLite database path
GW_DB=groupwisdom.db
# Global analysis kill switch: total spend (USD) across ALL users before every
# model call stops. The per-user $50 cap still applies individually. Default 250.
GW_GLOBAL_BUDGET_USD=
# Encryption at rest for message content (items, memory, knowledge docs,
# summaries). Any string; stretched to a 256-bit AES-GCM key. Generate with:
#   openssl rand -hex 32
# Unset = plaintext storage (dev only). Once set, keep it: losing the key
# loses the encrypted content.
GW_DATA_KEY=
# Days raw Buzz messages are kept before deletion (memory keeps the distilled
# facts). Default 30; 0 disables.
GW_BUZZ_RETENTION_DAYS=
# Session cookie signing secret. Unset in production = random per boot
# (sessions reset on each deploy).
SESSION_SECRET=
# Cross-account feedback totals at GET /v1/feedback/summary, for whoever runs
# this service. The account with this email sees the numbers; unset, the route
# 404s for everyone, so there is no dormant privilege in the code.
GW_ADMIN_EMAIL=
# ── Supabase Auth (preferred) ────────────────────────────────────────────────
# Identity, password reset and social sign-in. Both required to enable it.
# Settings → API in the Supabase dashboard. Never use the secret key
# (sb_secret_… / service_role): it bypasses row level security and nothing
# in this flow needs it.
# Add https://<your-domain>/auth/supabase/callback to Authentication → URL
# Configuration → Redirect URLs, and enable each provider you list below.
SUPABASE_URL=
# The browser-safe key. New projects call this "publishable" (sb_publishable_…),
# older ones called it "anon" — either variable name works.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Comma-separated social providers to offer. Default: google
SUPABASE_PROVIDERS=

# ── Direct Google OAuth (fallback) ───────────────────────────────────────────
# Only used when SUPABASE_URL/ANON_KEY are unset; Supabase is preferred because
# those accounts also get password reset.
# Sign in with Google. Both required to enable it; unset, the button never
# renders and /auth/google 404s. Create an OAuth 2.0 Client ID (type: Web
# application) at https://console.cloud.google.com/apis/credentials and add
# https://<your-domain>/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the callback URL. By default it is derived from the request,
# so one deploy works across every domain you have registered with Google.
GOOGLE_REDIRECT_URI=

# ── Buzz adapter (npm run buzz) — optional, standalone, does not affect the web server ──
# It talks to GroupWisdom over the real public /v1 API, like any external integration.
# Nostr relay URL for the Buzz workspace (local `just relay` or a hosted instance)
BUZZ_RELAY_URL=ws://localhost:3000
# The agent's Nostr private key — nsec1... or 64-char hex (from `buzz-admin generate-key`,
# or by claiming a Buzz invite link)
BUZZ_PRIVATE_KEY=
# Your personal GroupWisdom API key (gw_...) — the adapter creates/reads projects on your account
GROUPWISDOM_API_KEY=
# Optional: override the GroupWisdom API base (defaults to the production API)
GROUPWISDOM_BASE_URL=
# Optional: comma-separated channel UUIDs to watch immediately (else auto-discovers all)
BUZZ_CHANNELS=
# Optional NIP-OA attestation (JSON array) letting GroupWisdom join a community it was
# never enrolled in, via a member's authorization. Mint with `npm run buzz:authorize`.
BUZZ_AUTH_TAG=
