# Optional. Without a key the insight engine runs in mock mode.
ANTHROPIC_API_KEY=
# Claude model used by the insight engine
GW_MODEL=claude-sonnet-4-6
# Server port
PORT=3000
# SQLite database path
GW_DB=groupwisdom.db
# Global analysis kill switch: total spend (USD) across ALL users before every
# model call stops. The per-user $50 cap still applies individually. Default 250.
GW_GLOBAL_BUDGET_USD=
# Encryption at rest for message content (items, memory, knowledge docs,
# summaries). Any string; stretched to a 256-bit AES-GCM key. Generate with:
#   openssl rand -hex 32
# Unset = plaintext storage (dev only). Once set, keep it: losing the key
# loses the encrypted content.
GW_DATA_KEY=
# Days raw Buzz messages are kept before deletion (memory keeps the distilled
# facts). Default 30; 0 disables.
GW_BUZZ_RETENTION_DAYS=
# Session cookie signing secret. Unset in production = random per boot
# (sessions reset on each deploy).
SESSION_SECRET=

# ── Buzz adapter (npm run buzz) — optional, standalone, does not affect the web server ──
# It talks to GroupWisdom over the real public /v1 API, like any external integration.
# Nostr relay URL for the Buzz workspace (local `just relay` or a hosted instance)
BUZZ_RELAY_URL=ws://localhost:3000
# The agent's Nostr private key — nsec1... or 64-char hex (from `buzz-admin generate-key`,
# or by claiming a Buzz invite link)
BUZZ_PRIVATE_KEY=
# Your personal GroupWisdom API key (gw_...) — the adapter creates/reads projects on your account
GROUPWISDOM_API_KEY=
# Optional: override the GroupWisdom API base (defaults to the production API)
GROUPWISDOM_BASE_URL=
# Optional: comma-separated channel UUIDs to watch immediately (else auto-discovers all)
BUZZ_CHANNELS=
# Optional NIP-OA attestation (JSON array) letting GroupWisdom join a community it was
# never enrolled in, via a member's authorization. Mint with `npm run buzz:authorize`.
BUZZ_AUTH_TAG=
