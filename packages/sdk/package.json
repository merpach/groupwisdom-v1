{
  "name": "@groupwisdom/sdk",
  "version": "0.3.1",
  "description": "Official JavaScript/TypeScript SDK for the GroupWisdom API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node build-cjs.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "groupwisdom",
    "sdk",
    "api",
    "knowledge",
    "insights"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "homepage": "https://testgroupwisdom.com/docs.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merpach/groupwisdom-v1.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/merpach/groupwisdom-v1/issues"
  }
}
